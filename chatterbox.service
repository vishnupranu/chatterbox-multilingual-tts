[Unit]
Description=Chatterbox Multilingual TTS Production Daemon
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/chatterbox-multilingual-tts
Environment="PATH=/var/www/chatterbox-multilingual-tts/.venv/bin:/usr/local/bin:/usr/bin"
Environment="PYTORCH_ENABLE_MPS_FALLBACK=1"
Environment="PORT=8080"
ExecStart=/var/www/chatterbox-multilingual-tts/.venv/bin/uvicorn server:app --host 0.0.0.0 --port 8080 --workers 1
Restart=always
RestartSec=5
StandardOutput=append:/var/www/chatterbox-multilingual-tts/logs/service.log
StandardError=append:/var/www/chatterbox-multilingual-tts/logs/error.log

[Install]
WantedBy=multi-user.target
